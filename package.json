{
  "name": "@alludium/affinity-mcp-server",
  "version": "1.0.4",
  "description": "MCP server for Affinity CRM API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "affinity-mcp": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alludium/affinity-mcp-server.git"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "affinity",
    "crm",
    "model-context-protocol"
  ],
  "author": "Alludium",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.0.0",
    "dotenv": "^17.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
